{#- One Insights card. Expects a variable "post" (a page object from collections.posts). -#}
<article class="post-card">
  <p class="post-card-meta">{{ "For doctors" if post.data.category == "doctors" else "For practices" }}{% if post.data.type == "case-study" %} &middot; Case study{% endif %}</p>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.description }}</p>
  <p class="post-card-dates small">{{ post.data.date | dateAU }} &middot; verified {{ post.data.last_verified | dateAU }}</p>
</article>
